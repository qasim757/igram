# PORT: Port where the iGram Express and Vite server runs (default: 3000)
PORT=3000
NODE_ENV=development

# Extraction Provider Configuration
# Supported providers: "weirddl" (default, fastest) or "alldl"
PRIMARY_PROVIDER=weirddl
WEIRDDL_API_BASE=https://weirddl.sbs
ALLDL_API_BASE=https://ahm7xmakki.com

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

